Program Fuentes;

Uses
  Dos, Crt;

Const
  Pitch                 = 1;
  Max                   = 100;

Type
  Tipo                  = Array[0..223] Of Record
                                             Bitmap : Array[0..15] Of Array[0..13] Of Byte;
                                           End;


Var
  Font                  : ^Tipo;
  TMaxY, TMinY, TMaxX   : Byte;
  Indice                : Word;


Procedure LoadFont(CX, CY : LongInt);
  Var
    X, Y, FX, FY                : LongInt;
    Origen                      : File;
    Cadena                      : Array[00..13] Of Byte;
    D                           : Byte;
  Begin
    Assign(Origen, 'FONTS.VGA'); Reset(Origen, 1);
    { Tama¤o de la rejilla (en caracteres) : 32 * 07 }
    { Tama¤o del caracter  (en pixels)     : 14 * 16 }
    Seek(Origen, 4+((CY*640)+CX)+641);
    For FY:=00 To 06 Do
      Begin
        For Y:=0 To 15 Do
          Begin
            For FX:=00 To 31 Do
              Begin
                BlockRead(Origen, Cadena, 14);
                For X:=000 To 013 Do Font^[FY*32+FX].Bitmap[Y][X]:=Cadena[X];
                BlockRead(Origen, Cadena, 1);
              End;
            Seek(Origen, FilePos(Origen)+160)
          End;
        Seek(Origen, FilePos(Origen)+640)
      End;
    Close(Origen);
    TMinY:=15;
    TMaxY:=00;
    For FY:=000 To 223 Do
      For Y:=0 To 15 Do
        For X:=0 To 13 Do
          Begin
            If Font^[FY].Bitmap[Y][X]=1 Then
              Begin
                If TMinY > Y Then TMinY:=Y;
                If TMaxY < Y Then TMaxY:=Y;
              End;
          End;

    TMaxX:=0;
    For FY:=0 To 223 Do
      Begin
        D:=$00;
        For X:=0 To 13 Do
          Begin
            For Y:=0 To 15 Do
              If Font^[FY].Bitmap[Y][X]=1 Then
                Begin
                  If X > TMaxX Then TMaxX:=X;
                  If D=$00 Then D:=X
                End;
          End;
        If D>01 Then
          For Y:=0 To 15 Do
            Move(Mem[Seg(Font^):Ofs(Font^)+(FY*224)+(Y*14)], Mem[Seg(Font^):Ofs(Font^)+(FY*224)+(Y*14)-D+0], 14);
      End;
  End;


Procedure Texto(PX, PY : Word; T : String);
  Var
    W, C, N, A, B, X, Y      : Word;
    EOC, Q, K, j, l          : Word;
    r    : byte;
    m      : word;
  Label
    Uno, Cero, adios;

  Begin
    Asm
      MOV AX, [Offset(Font)]    { OJO con los corchetes !! }
      MOV K, AX
    End;
    For Q:=1 To Length(T) Do
      Begin
        Case T[Q] Of
          #33..#125 : Begin
                        N:=Ord(T[Q])-32;
                        Asm
                          XOR AX, AX
                          MOV AX, EOC
                        End;
                      End;
          #32       : Asm
                        MOV EOC, 4
                        XOR AX, AX
                        MOV N, AX
                      End;
          Else
            Asm
              MOV EOC, 4
              XOR AX, AX
              MOV N, AX
            End;
        End;
        For X:=0 To TMaxX Do
          For Y:=TMinY To TMaxY Do
            Begin

              Asm
                MOV SI, X
                MOV DI, Y

                End;
              j:=Y*14+n*224+x;
              l:=N*224;


              Asm

              mov ax, j
              mov cx, l
                end;

                asm

                MOV BX, AX
                MOV ax, Word(Font+2)
                MOV ES, AX
                MOV AH, [ES:BX]
                mov r, ah

                MOV ax, Word(Font+2)
                mov m, ax

end;

if r = 1 then goto uno ;
goto cero;
                Uno:
                {
                ax:=Py;
                di:=di+py;
                a:=di;
                bx:=si+px
                b:=bx:
                ax:=di*10;
                ax:=ax shl 3;
                bx:=b;
                 }
                 mem[$a000:(py+y+40)*320+(px+x+q*1)]:=r;

                asm
                MOV AX, PY
                ADD DI, AX
                MOV A, DI
                MOV BX, SI
                ADD BX, PX
                MOV B, BX
                MOV AX, DI
                MOV BX, 10d
                MUL BX
                SHL AX, 3d
                MOV BX, B
                SHR BX, 3d
                ADD AX, BX
                MOV DX, AX
                MOV DI, B
                AND DI, 7d
                MOV EOC, SI
{                MOV AX, DI
                ADD AX, AX
{                MOV BX, Offset(Potencias)
                ADD BX, AX
                MOV AX, [BX]
{                MOV CX, 0A000h
                MOV ES, CX
                MOV BX, DX
{                MOV CX, [ES:BX]}
                OR CX, AX
{                MOV [ES:BX], CX}
              End;
                Cero:

            End;
        Asm
          MOV AX, PX
          ADD AX, EOC
          ADD AX, Pitch
          MOV PX, AX
        End;
        {PX:=PX+8;}
      End;
  End;

Const
  Frase = 'nahi duzuena (bigarren milenioa) ';

Begin
  Textmode(3);
  writeln(maxavail);
  Asm
    MOV AX, 13h
    INT 10h
  End;
  New(Font);
  LoadFont(000, 0);
  For Indice:=000 To 00{27} Do Texto(10, Indice*15, Frase);
  Dispose(Font);
  Repeat Until KeyPRessed;
  {TextMode(3);
  WriteLn(LapsoTiempo); Halt;}

End.