{$A+,B-,D+,E+,F-,G+,I-,L+,N-,O-,P-,Q-,R-,S-,T-,V+,X+,Y+}
{$M 16384,0,655360}
{$G+}
Program Masacre;

Uses
  Dos, Crt, Grafx, VocPlay, mixer;

Const
  Pitch                 = 1;
  Max                   = 100;
  e =7 ;


Var
  Ch            : Char;
  NOP           : Boolean;
  Origen                : File;
  Sprites1, Sprites2    : Pointer;
  Fondo                 : Pointer;
  R, X, Y               : LongInt;
  Linea                 : Array[0..319] Of LongInt;
  W                     : Word;
  Paleta                : TPaleta;
  Titulo1, Titulo2      : Pointer;

  Screen                        : Pointer;
  banko                         : byte;
  ScrOfs, ScrSeg          : longint;
  c                             : Byte;




Type
  TSprite              = Record X1, Y1, X2, Y2, CX, CY : Integer; End;

Const
  Sprite               : Array[1..20] Of TSprite =
                         (
                         (X1:001; Y1:001; X2:039; Y2:061; CX:+00; CY:+00),
                         (X1:041; Y1:001; X2:079; Y2:062; CX:+00; CY:-02),
                         (X1:081; Y1:001; X2:118; Y2:063; CX:+05; CY:-01),
                         (X1:120; Y1:001; X2:178; Y2:056; CX:-03; CY:-01),
                         (X1:180; Y1:001; X2:220; Y2:033; CX:+07; CY:+30),

                         (X1:001; Y1:063; X2:038; Y2:116; CX:+07; CY:+00),
                         (X1:040; Y1:064; X2:073; Y2:116; CX:+07; CY:+01),
                         (X1:075; Y1:065; X2:101; Y2:117; CX:+10; CY:+00),
                         (X1:103; Y1:065; X2:158; Y2:109; CX:-04; CY:+00),
                         (X1:160; Y1:058; X2:205; Y2:086; CX:+0;  CY:+27),

                         (X1:001; Y1:118; X2:037; Y2:178; CX:+07; CY:+18),
                         (X1:039; Y1:118; X2:073; Y2:181; CX:+04; CY:+18),
                         (X1:075; Y1:119; X2:116; Y2:183; CX:+02; CY:+18),
                         (X1:118; Y1:122; X2:181; Y2:181; CX:-8; CY:+18),
                         (X1:160; Y1:088; X2:208; Y2:120; CX:-07; CY:+42),

                         (X1:183; Y1:122; X2:237; Y2:195; CX:-07; CY:+42),
                         (X1:001; Y1:001; X2:050; Y2:080; CX:-01; CY:+42),
                         (X1:053; Y1:001; X2:122; Y2:086; CX:-22; CY:+33),

                         {EL PROTAGONISTA}
                         (X1:001; Y1:082; X2:034; Y2:157; CX:000; CY:000),
                         (X1:036; Y1:088; X2:076; Y2:162; CX:000; CY:000)
                         );

Type
  Tipo                  = Array[0..223] Of Record
                                             Bitmap : Array[0..16] Of Array[0..11] Of Byte;
                                           End;

procedure setpixel(x, y : Longint; C : byte);
  var
    b, d : longint;
  Begin
     d:=(Y*640+X);
     B:=D SHR 16;

     if b<>banko then
       begin
         asm
           mov ax,$4f05
           xor bx, bx
           mov dx,word(b)
           int $10
         end;
       banko:=B;
       end;
    d:=d-(b shl 16);
    asm
      mov ax, 0a000h
      mov es, ax
      mov bx, word(d)
      mov cl, c
      mov byte ptr [es:bx], cl

    end;
  end;



Var
  Font                  : ^Tipo;
  TMaxY, TMinY, TMaxX   : Byte;
  Indice                : Word;

Procedure LoadFont(CX, CY : LongInt);
  Var
    X, Y, FX, FY                : LongInt;
    Origen                      : File;
    Cadena                      : Array[00..13] Of Byte;
    D                           : Byte;
  Begin
    Assign(Origen, 'FONTS.VGA'); Reset(Origen, 1);
    { Tama¤o de la rejilla (en caracteres) : 32 * 07 }
    { Tama¤o del caracter  (en pixels)     : 14 * 16 }
    Seek(Origen, 4+((CY*640)+CX)+641);
    For FY:=00 To 06 Do
      Begin
        For Y:=0 To 16 Do
          Begin
            For FX:=00 To 31 Do
              Begin
                BlockRead(Origen, Cadena, 12);
                For X:=000 To 011 Do Font^[FY*32+FX].Bitmap[Y][X]:=Cadena[X];
                BlockRead(Origen, Cadena, 1);
              End;
            Seek(Origen, FilePos(Origen)+224)
          End;
        Seek(Origen, FilePos(Origen)+640)
      End;
    Close(Origen);

    TMinY:=16;
    TMaxY:=00;
    For FY:=000 To 223 Do
      For Y:=0 To 16 Do
        For X:=0 To 11 Do
          Begin
            If Font^[FY].Bitmap[Y][X]<>255 Then
              Begin
                If TMinY > Y Then TMinY:=Y;
                If TMaxY < Y Then TMaxY:=Y;
              End;
          End;

    TMaxX:=0;

    For FY:=0 To 223 Do
      Begin
        D:=$00;
        For X:=0 To 11 Do
          Begin
            For Y:=0 To 16 Do
              If Font^[FY].Bitmap[Y][X]<>255 Then
                Begin
                  If X > TMaxX Then TMaxX:=X;
                  If D=$00 Then D:=X
                End;
          End;
        If D>01 Then
          For Y:=0 To 16 Do
            Move(Mem[Seg(Font^):Ofs(Font^)+(FY*204)+(Y*12)], Mem[Seg(Font^):Ofs(Font^)+(FY*204)+(Y*12)-D+0], 12);

      End;
  End;

Procedure Texto(PX, PY : integer; T : String);
  Var
    W, C, N, A, B, X, Y      : Word;
    EOC, Q, K                : Word;
    r :byte;
  Label
    Uno, Cero;

  Begin
    py:=py-3;
    Asm
      MOV AX, [Offset(Font)]    { OJO con los corchetes !! }
      MOV K, AX
    End;
    For Q:=1 To Length(T) Do
      Begin
        Case T[Q] Of
          #33..#125 : Begin
                        N:=Ord(T[Q])-32;
                        Asm
                          XOR AX, AX
                          MOV AX, EOC
                        End;
                      End;
          #32       : Asm
                        MOV EOC, pitch*2
                        XOR AX, AX
                        MOV N, AX
                      End;
          Else
            Asm
              MOV EOC, 4
              XOR AX, AX
              MOV N, AX
            End;
        End;
        For X:=0 To TMaxX Do
          For Y:=TMinY To TMaxY Do
            Begin
              Asm
                MOV SI, X
                MOV DI, Y

                MOV AX, N
                MOV BX, 204
                MUL BX
                MOV CX, AX
                MOV AX, DI
                MOV BX, 12d
                MUL BX
                ADD AX, DX
                ADD AX, CX
                ADD AX, SI
                MOV BX, AX
                MOV AX, Word(Font+2)
                MOV ES, AX
                MOV AH, [ES:BX]
                CMP AH, 1
                mov r, ah
                End;

              if r =255 then goto cero;
                asm
                MOV AX, PY
                ADD DI, AX
                MOV A, DI
                MOV BX, SI
                ADD BX, PX
                MOV B, BX
                MOV AX, DI
                MOV BX, 10d
                MUL BX
                SHL AX, 3d
                MOV BX, B
                SHR BX, 3d
                ADD AX, BX
                MOV DX, AX
                MOV DI, B
                AND DI, 7d
                MOV EOC, SI
                MOV AX, DI
                ADD AX, AX
              End;
              Mem[$A000:(Y+PY)*320+X+PX-q*1]:=R;
                {
                MOV BX, Offset(Potencias)
                ADD BX, AX
                MOV AX, [BX]
                MOV CX, 0A000h
                MOV ES, CX
                MOV BX, DX
                MOV CX, [ES:BX]
                OR CX, AX
                MOV [ES:BX], CX
                }
                Cero:
            End;
        Asm
          MOV AX, PX
          ADD AX, EOC
          ADD AX, Pitch
          MOV PX, AX
        End;
        {PX:=PX+8;}
        waitretrace;
      End;
  End;

Procedure Center(px, PY : integer; T : String; descent : integer);
  Var
    W, C, N, A, B, X, Y      : Word;
    EOC, Q, K, opx           : Word;
    r :byte;
  Label
    Uno, Cero;

  Begin
  opx:=px;
    Asm
      MOV AX, [Offset(Font)]    { OJO con los corchetes !! }
      MOV K, AX
    End;
    For Q:=1 To Length(T) Do
      Begin
        Case T[Q] Of
          #33..#125 : Begin
                        N:=Ord(T[Q])-32;
                        Asm
                          XOR AX, AX
                          MOV AX, EOC
                        End;
                      End;
          #32       : Asm
                        MOV EOC, pitch*2
                        XOR AX, AX
                        MOV N, AX
                      End;
          Else
            Asm
              MOV EOC, 4
              XOR AX, AX
              MOV N, AX
            End;
        End;
        For X:=0 To TMaxX Do
          For Y:=TMinY To TMaxY Do
            Begin
              Asm
                MOV SI, X
                MOV DI, Y

                MOV AX, N
                MOV BX, 204
                MUL BX
                MOV CX, AX
                MOV AX, DI
                MOV BX, 12d
                MUL BX
                ADD AX, DX
                ADD AX, CX
                ADD AX, SI
                MOV BX, AX
                MOV AX, Word(Font+2)
                MOV ES, AX
                MOV AH, [ES:BX]
                CMP AH, 1
                mov r, ah
                End;

              if r =255 then goto cero;
                asm
                MOV AX, PY
                ADD DI, AX
                MOV A, DI
                MOV BX, SI
                ADD BX, px
                MOV B, BX
                MOV AX, DI
                MOV BX, 10d
                MUL BX
                SHL AX, 3d
                MOV BX, B
                SHR BX, 3d
                ADD AX, BX
                MOV DX, AX
                MOV DI, B
                AND DI, 7d
                MOV EOC, SI
                MOV AX, DI
                ADD AX, AX
              End;
{              Mem[$A000:(Y+PY)*320+X+PX-q*1]:=R;}
                {
                MOV BX, Offset(Potencias)
                ADD BX, AX
                MOV AX, [BX]
                MOV CX, 0A000h
                MOV ES, CX
                MOV BX, DX
                MOV CX, [ES:BX]
                OR CX, AX
                MOV [ES:BX], CX
                }
                Cero:
            End;
        Asm
          MOV AX, px
          ADD AX, EOC
          ADD AX, Pitch
          MOV PX, AX
        End;
        {PX:=PX+8;}
      End;
    texto(160-(((px-q)-opx) div 2)+descent, py, t);
  End;

Procedure DrawSprite(Cual : Word; DondeX, DondeY : Word);
  Var
    X, Y                        : Word;
    X1, Y1, X2, Y2              : Word;
    Color                       : Byte;
  Begin
    X1:=Sprite[Cual].X1;
    Y1:=Sprite[Cual].Y1;
    X2:=Sprite[Cual].X2;
    Y2:=Sprite[Cual].Y2;
    {
    For Y:=Y1 To Y2 Do
      For X:=X1 To X2 Do
        Begin
          Color:=Mem[Seg(Sprites1^):Y*320+X];
          If Color <> 1 Then
            Mem[$A000:(DondeY+Y-Y1+Sprite[Cual].CY)*320+DondeX+X-X1+Sprite[Cual].CX]:=Color;
        End;
        }
    For Y:=0 To Y2-Y1 Do
      For X:=0 To X2-X1 Do
        Begin
          If Cual < 17 Then
            Color:=Mem[Seg(Sprites1^):(Y+Y1)*320+(X+X1)]
          Else
            Color:=Mem[Seg(Sprites2^):(Y+Y1)*320+(X+X1)];
          If Color <> 1 Then
            Mem[$A000:(DondeY+Y+Sprite[Cual].CY)*320+DondeX+X+Sprite[Cual].CX]:=Color;
        End;
  End;

Procedure PonFondo(Cual : Word; DondeX, DondeY : Word);
  Var
    X, Y                        : Word;
    X1, Y1, X2, Y2              : Word;
    Color                       : Byte;
  Begin
    X1:=Sprite[Cual].X1;
    Y1:=Sprite[Cual].Y1;
    X2:=Sprite[Cual].X2;
    Y2:=Sprite[Cual].Y2;
    For Y:=0 To Y2-Y1 Do
      For X:=0 To X2-X1 Do
        Begin
          Color:=Mem[Seg(Fondo^):(DondeY+Y+Sprite[Cual].CY)*320+DondeX+X+Sprite[Cual].CX];
          Mem[$A000:(DondeY+Y+Sprite[Cual].CY)*320+DondeX+X+Sprite[Cual].CX]:=Color;
        End;
    {
    For Y:=Y1 To Y2 Do
      For X:=X1 To X2 Do
        Begin
          Color:=Mem[Seg(Fondo^):(DondeY+Y-Y1+Sprite[Cual].CY)*320+DondeX+X-X1+Sprite[Cual].CX];
          Mem[$A000:(DondeY+Y-Y1+Sprite[Cual].CY)*320+DondeX+X-X1+Sprite[Cual].CX]:=Color;
        End;
        }
  End;

